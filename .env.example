# ======================
# Telegram
# ======================
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
ADMIN_IDS=[123456789]

# Local Telegram Bot API Server (recommended for files > 50MB)
# If empty → official api.telegram.org is used
TELEGRAM_API_SERVER=
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=

# ======================
# Database (PostgreSQL)
# ======================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=vdbot
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=video_downloader

# Full async DSN (auto-built if not set)
# DATABASE_URL=postgresql+asyncpg://vdbot:change_me_strong_password@postgres:5432/video_downloader

# ======================
# Redis (Cache + Celery Broker + Backend)
# ======================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Celery specific
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ======================
# Bot Behaviour
# ======================
# Free user daily download limit
FREE_DAILY_LIMIT=5
# Max quality for free users (720 / 480 / 360)
FREE_MAX_QUALITY=720

# Rate limiting (requests per window)
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60

# Force subscription (channel usernames or IDs as JSON list)
FORCE_SUB_CHANNELS=[]

# ======================
# Downloader
# ======================
# yt-dlp cookies file path (optional)
YTDLP_COOKIES_FILE=/app/cookies/cookies.txt

# Proxy list (JSON list, e.g. ["http://user:pass@ip:port"] or [])
PROXIES=[]

# Download directory (inside container)
DOWNLOAD_DIR=/tmp/downloads

# Max file size in MB (Telegram limit is ~2GB with Local API)
MAX_FILE_SIZE_MB=2000

# O'z-o'zida joylashtirilgan Cobalt server (docker-compose'dagi "cobalt" xizmati).
# Bo'sh qoldirilsa, faqat tashqi (public) Cobalt oynalariga tayaniladi.
COBALT_LOCAL_URL=http://cobalt:9000
# Faqat COBALT_LOCAL_URL'ga o'zingiz API_AUTH_REQUIRED yoqib API-key qo'ygan bo'lsangiz kerak
COBALT_API_KEY=
# Ochiq (public) Cobalt zaxira instance'lari (vergul bilan ajratilgan URL'lar).
# Bo'sh qoldiring — 2026 holatida deyarli barchasi JWT/Turnstile talab qiladi
# va ishlamaydi. Faqat token talab qilmaydigan/o'zingiz API-key olgan
# instance topsangiz shu yerga qo'shing.
COBALT_PUBLIC_INSTANCES=

# ======================
# Logging
# ======================
LOG_LEVEL=INFO
ENVIRONMENT=development